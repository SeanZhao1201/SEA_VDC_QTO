<Window x:Class="QTO_Tool.FormworkUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QTO_Tool"
             mc:Ignorable="d" Loaded="Window_Loaded"
             Title="FORMWORK GENERATION" Width="760" Height="800" MinHeight="600" MinWidth="700">

    <Border Padding="10">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="0 10 0 0">

                <TextBlock Text="FORMWORK" FontSize="42" Margin="5 0 0 10"
                           Foreground="#036fad" FontWeight="DemiBold"/>

                <GroupBox Header="Take-off freshness" Margin="10" Padding="12"
                          BorderThickness="3" BorderBrush="Gray" FontSize="18">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Name="StampLight" Width="26" Height="26"
                                     Fill="Firebrick" Margin="0 0 12 0"/>
                            <TextBlock Name="StampHeadline" FontSize="20"
                                       FontWeight="DemiBold" VerticalAlignment="Center"
                                       Text="Checking..."/>
                        </StackPanel>
                        <TextBlock Name="StampReason" FontSize="16" Margin="38 6 0 0"
                                   TextWrapping="Wrap" Text=""/>
                        <Button Name="RecheckButton" Content="RE-CHECK" Width="160"
                                Height="36" FontSize="16" Margin="38 10 0 0"
                                HorizontalAlignment="Left" Click="Recheck_Clicked"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Input model" Margin="10 0 10 10" Padding="12"
                          BorderThickness="3" BorderBrush="Gray" FontSize="18">
                    <StackPanel Orientation="Vertical">
                        <RadioButton Name="InputOriginal" Content="Original model (staged copy)"
                                     FontSize="16" IsChecked="True" Margin="0 2 0 2"/>
                        <RadioButton Name="InputDerived" FontSize="16" Margin="0 2 0 2"
                                     Content="Pour-break derived model (run Split first)"
                                     IsEnabled="False"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Pour breaks" Margin="10 0 10 10" Padding="12"
                          BorderThickness="3" BorderBrush="Gray" FontSize="18">
                    <StackPanel Orientation="Vertical">
                        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0 0 0 8"
                                   Text="Draw break curves on the _POURBREAK layer (sublayer per floor optional) with a numbered text dot in each pour region. Harvest is read-only; Restore re-draws harvested breaks after a checkup wiped them."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Name="HarvestButton" Content="HARVEST" Width="200" Height="52"
                                    FontSize="20" Margin="5" Click="Harvest_Clicked"/>
                            <Button Name="RestoreButton" Content="RESTORE" Width="200" Height="52"
                                    FontSize="20" Margin="5" Click="Restore_Clicked"/>
                            <Button Name="SplitButton" Content="SPLIT BREAKS" Width="200" Height="52"
                                    FontSize="20" Margin="5" Background="#52a0d1"
                                    Click="Split_Clicked"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Generate" Margin="10 0 10 10" Padding="12"
                          BorderThickness="3" BorderBrush="Gray" FontSize="18">
                    <StackPanel Orientation="Vertical">
                        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0 0 0 8"
                                   Text="Runs in a second, headless Rhino on the selected model copy - the open document is never touched. Output lands in the staging folder."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Name="GenerateButton" Content="GENERATE FORMWORK"
                                    Width="310" Height="60" FontSize="20" Margin="5"
                                    Background="#98AD80" Click="Generate_Clicked"/>
                            <Button Name="OpenOutputButton" Content="OPEN OUTPUT FOLDER"
                                    Width="310" Height="60" FontSize="20" Margin="5"
                                    Click="OpenOutput_Clicked"/>
                        </StackPanel>
                        <Button Name="CancelRunButton" Content="CANCEL RUN" Width="200"
                                Height="40" FontSize="16" Margin="5"
                                HorizontalAlignment="Center" IsEnabled="False"
                                Click="CancelRun_Clicked"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Log" Margin="10 0 10 10" Padding="8"
                          BorderThickness="3" BorderBrush="Gray" FontSize="18">
                    <TextBox Name="LogBox" FontFamily="Consolas" FontSize="13"
                             IsReadOnly="True" TextWrapping="NoWrap" Height="220"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
