<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>QTO_Tool</RootNamespace>
    <AssemblyName>QTO_Tool</AssemblyName>
    <!-- Rhino only loads plugins with the .rhp extension. -->
    <TargetExt>.rhp</TargetExt>
    <!-- Assembly metadata, including the Guid attribute that Rhino uses as the
         permanent plugin ID, lives in Properties\AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <FallbackCulture>en-US</FallbackCulture>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time reference assemblies so net48 compiles on machines without the
         .NET Framework targeting pack (dotnet build locally and on CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Excel export writes the workbook directly from the embedded template.
         Desktop Excel is not required and is never launched. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RhinoCommon" Version="7.28.23058.3001" />
    <PackageReference Include="Xbim.Common" Version="6.1.605" />
    <PackageReference Include="Xbim.Ifc" Version="6.1.605" />
    <PackageReference Include="Xbim.Ifc4" Version="6.1.605" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logical name QTO_Tool.EmbeddedResources.plugin-utility.ico is referenced by
         the PlugInDescription icon attribute in AssemblyInfo.cs. -->
    <EmbeddedResource Include="EmbeddedResources\plugin-utility.ico" />
    <EmbeddedResource Update="Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Resource Include="Resources\Excel\template.xlsx" />
    <Resource Include="Resources\Images\ProgressImage.png" />
  </ItemGroup>

</Project>
