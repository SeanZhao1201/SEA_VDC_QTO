<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>QTO_Tool</RootNamespace>
    <AssemblyName>QTO_Tool</AssemblyName>
    <!-- Rhino only loads plugins with the .rhp extension. -->
    <TargetExt>.rhp</TargetExt>
    <!-- Assembly metadata, including the Guid attribute that Rhino uses as the
         permanent plugin ID, lives in Properties\AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <FallbackCulture>en-US</FallbackCulture>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time reference assemblies so net48 compiles on machines without the
         .NET Framework targeting pack (dotnet build locally and on CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Excel export writes the workbook directly from the embedded template.
         Desktop Excel is not required and is never launched. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RhinoCommon" Version="7.28.23058.3001" />
    <PackageReference Include="Xbim.Common" Version="6.1.605" />
    <PackageReference Include="Xbim.Ifc" Version="6.1.605" />
    <PackageReference Include="Xbim.Ifc4" Version="6.1.605" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logical name QTO_Tool.EmbeddedResources.plugin-utility.ico is referenced by
         the PlugInDescription icon attribute in AssemblyInfo.cs. -->
    <EmbeddedResource Include="EmbeddedResources\plugin-utility.ico" />
    <EmbeddedResource Update="Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Resource Include="Resources\Excel\template.xlsx" />
    <Resource Include="Resources\Images\ProgressImage.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The formwork Python engines, embedded as LINKS from
         Formwork_Generation/rhino - one source of truth, no forked copies.
         FormworkMethods.ExtractScripts() writes them to the staging folder
         at runtime; logical names must match its Scripts list. -->
    <EmbeddedResource Include="..\Formwork_Generation\rhino\formwork_gen_rhino.py" Link="Formwork\formwork_gen_rhino.py" LogicalName="QTO_Tool.Formwork.formwork_gen_rhino.py" />
    <EmbeddedResource Include="..\Formwork_Generation\rhino\sideform_gen_rhino.py" Link="Formwork\sideform_gen_rhino.py" LogicalName="QTO_Tool.Formwork.sideform_gen_rhino.py" />
    <EmbeddedResource Include="..\Formwork_Generation\rhino\pourbreak_harvest.py" Link="Formwork\pourbreak_harvest.py" LogicalName="QTO_Tool.Formwork.pourbreak_harvest.py" />
    <EmbeddedResource Include="..\Formwork_Generation\rhino\pourbreak_restore.py" Link="Formwork\pourbreak_restore.py" LogicalName="QTO_Tool.Formwork.pourbreak_restore.py" />
    <EmbeddedResource Include="..\Formwork_Generation\rhino\split_pourbreaks.py" Link="Formwork\split_pourbreaks.py" LogicalName="QTO_Tool.Formwork.split_pourbreaks.py" />
    <EmbeddedResource Include="..\Formwork_Generation\rhino\run_on_model.py" Link="Formwork\run_on_model.py" LogicalName="QTO_Tool.Formwork.run_on_model.py" />
    <EmbeddedResource Include="..\Formwork_Generation\rhino\run_sideforms_on_model.py" Link="Formwork\run_sideforms_on_model.py" LogicalName="QTO_Tool.Formwork.run_sideforms_on_model.py" />
  </ItemGroup>

</Project>
