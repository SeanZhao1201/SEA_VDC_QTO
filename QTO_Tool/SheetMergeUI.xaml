<Window x:Class="QTO_Tool.SheetMergeUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QTO_Tool"
             mc:Ignorable="d" WindowStartupLocation="CenterOwner"
             Title="TYP MERGE" Width="680" Height="480" MinWidth="560" MinHeight="360">

    <Border Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="14" TextWrapping="Wrap" Margin="5"
                       Text="These floor cells have NEAR-identical slab footprints. Checked entries share ONE cell on the regenerated sheet, and breaks drawn there fan out to every member floor at import. The merged cell shows the lowest floor's footprint - the other members only nearly match it, so review the deviation before relying on the shared cell."/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                <StackPanel Name="MergeListWrapper"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="ApplyButton" Content="APPLY + REGENERATE" Width="240" Height="44"
                        FontSize="16" Margin="5" Background="#52a0d1" Click="Apply_Clicked"/>
                <Button Name="CancelButton" Content="KEEP AS IS" Width="180" Height="44"
                        FontSize="16" Margin="5" Click="Cancel_Clicked"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
